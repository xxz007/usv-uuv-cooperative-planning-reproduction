// P5 local-ENU waypoint task; derived interface: s1_alpha and BHV_Waypoint.
initialize DEPLOY = false
initialize MOOS_MANUAL_OVERRIDE = false
Behavior = BHV_Waypoint
{
  name = p5_task
  pwt = 100
  condition = DEPLOY = true
  condition = P5_TASK_ID = P5-T01
  updates = WPT_UPDATE
  perpetual = false
  endflag = P5_TASK_DONE = P5-T01
  endflag = DEPLOY = false
  speed = 2.0
  capture_radius = 2.5
  slip_radius = 2.5
  capture_line = false
  points = 190,-190
  repeat = 0
}
